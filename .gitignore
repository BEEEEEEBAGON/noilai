# downloaded third-party resources are fetched by scripts/fetch_resources.py (hashes recorded there)
data/external/*
!data/external/README.md
data/runs/*
!data/runs/README.md
# validator and human-baseline material (forms, returned sheets, consent): never committed, never in
# the bundle a notebook clones (DESIGN_DECISIONS 11.2: participant data leaves the machine for nothing)
data/validation/
data/human/
__pycache__/
*.pyc
.pytest_cache/
.hypothesis/
*.egg-info/
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.pdf
.venv/
data/cache/
data/release/*/*.jsonl
# the private release manifest carries the build seed and the canary GUID (DESIGN_DECISIONS 4.6): never tracked
data/release/*/manifest_private.json
data/audit/items_*.jsonl
dist/
